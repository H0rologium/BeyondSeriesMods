        <jobString>Creating a catalyst.</jobString>
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <effectWorking>Cook</effectWorking>
        <soundWorking>Recipe_Machining</soundWorking>
        <workAmount>16000</workAmount>
        <ingredients>
            <li>
                <filter>
                <thingDefs>
                    <li>AncientResearchCore</li>
                </thingDefs>
                </filter>
                <count>5</count>
            </li>
            <li>
                <filter>
                <thingDefs>
                    <li>Plasteel</li>
                </thingDefs>
                </filter>
                <count>80</count>
            </li>
            <li>
                <filter>
                <thingDefs>
                    <li>ComponentSpacer</li>
                </thingDefs>
                </filter>
                <count>2</count>
            </li>
            <li>
                <filter>
                <thingDefs>
                    <li>Gold</li>
                </thingDefs>
                </filter>
                <count>9</count>
            </li>
        </ingredients>
        <products>
            <SentienceCatalyst>1</SentienceCatalyst>
        </products>
        <researchPrerequisites>
            <li>ShipCryptosleep</li>
