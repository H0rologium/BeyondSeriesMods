			<min>500</min>
			<max>800</max>
		</weaponMoney>
        <weaponTags>
            <li>IndustrialGunAdvanced</li>
            <li>SniperRifle</li>
        </weaponTags>
        <combatEnhancingDrugsChance>0.25</combatEnhancingDrugsChance>
		<combatEnhancingDrugsCount>0~1</combatEnhancingDrugsCount>
        <inventoryOptions>
			<skipChance>0.15</skipChance>
			<subOptionsChooseOne>
