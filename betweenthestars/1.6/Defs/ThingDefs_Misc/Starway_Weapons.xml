<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="BaseHumanMakeableGun" Name="Gun_BeamPistol">
    <defName>Gun_BeamPistol</defName>
    <label>beam pistol</label>
    <description>An ultratech weapon that emits a gamma ray burst when fired. The tight gamma beams can pierce shields.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/BeamPistol</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_Autopistol</soundInteract>
    <thingSetMakerTags><li>RewardStandardQualitySuper</li></thingSetMakerTags>
    <weaponClasses>
      <li>RangedHeavy</li>
      <li>Ultratech</li>
    </weaponClasses>
    <statBases>
      <WorkToMake>50000</WorkToMake>
      <Mass>10</Mass>
      <AccuracyTouch>0.80</AccuracyTouch>
      <AccuracyShort>0.75</AccuracyShort>
      <AccuracyMedium>0.65</AccuracyMedium>
      <AccuracyLong>0.65</AccuracyLong>
      <RangedWeapon_Cooldown>1</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Plasteel>35</Plasteel>
      <Steel>40</Steel>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <recipeMaker>
      <researchPrerequisite>BeamWeapons</researchPrerequisite>
      <skillRequirements>
        <Crafting>9</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
      <displayPriority>220</displayPriority>
    </recipeMaker>
    <techLevel>Spacer</techLevel>
    <weaponTags>
      <li>GunHeavy</li>
      <li>BeamGraserPistol</li>
    </weaponTags>
    <equippedStatOffsets>
      <MoveSpeed>-0.15</MoveSpeed>
    </equippedStatOffsets>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_BeamRepeater</defaultProjectile>
        <warmupTime>0.5</warmupTime>
        <range>16</range>
        <burstShotCount>1</burstShotCount>
        <ticksBetweenBurstShots>2</ticksBetweenBurstShots>
        <soundCast>Shot_BeamRepeater</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
        <aimingChargeMote>Mote_BeamRepeater_Charge</aimingChargeMote>
        <aimingChargeMoteOffset>1.07</aimingChargeMoteOffset>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrels</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>

