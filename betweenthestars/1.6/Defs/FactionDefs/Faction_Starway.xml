<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <FactionDef Name="BTS_StarwayBase" Abstract="True">
    <raidLootValueFromPointsCurve>
      <points>
        <li>(35,     15)</li>
        <li>(100,   120)</li>
        <li>(1000,  500)</li>
        <li>(2000,  800)</li>
        <li>(4000, 1000)</li>
      </points>
    </raidLootValueFromPointsCurve>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(1300, 1500)</li>
        <li>(100000, 20000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <earliestRaidDays>30</earliestRaidDays>
	</FactionDef>

   <!-- ===================================================================================== -->

    <FactionDef ParentName="BTS_StarwayBase">
    <defName>BTS_Starway</defName>
    <label>Starway Incorporated</label>
    <!--<fixedName>Starway Incorporated</fixedName>-->
    <pawnSingular>member</pawnSingular>
    <pawnsPlural>members</pawnsPlural>
    <leaderTitle>chairman</leaderTitle>
    <fixedLeaderKinds>
      <li>BTS_Chairman</li>
    </fixedLeaderKinds>
    <techLevel>Ultra</techLevel>
    <description>A conglomerate that has existed for so long due to sheer influence. Recruiting anyone willing to follow in their path, this faction has rumors about the practices that the leadership enforces. Whispers of strange authority crackdowns and funding to miscellaneous mining trips has people believing these members are closer to a cult than a multiplanetary organization.\n\nIn general they don't mind working with others, but can get quite mad if you openly disapprove of or shame their goals. Their resourcefulness has led them to adopt the technologies of this RimWorld to further their goals, enjoying the work of the local researchers rather than attempting to innovate on their own.</description>
    <factionNameMaker>NamerFactionSalvagers</factionNameMaker>
    <settlementNameMaker>NamerSettlementOutlander</settlementNameMaker>
    <canSiege>false</canSiege>
	  <autoFlee>false</autoFlee>
    <canStageAttacks>false</canStageAttacks>
	  <naturalEnemy>false</naturalEnemy>
    <allowedArrivalTemperatureRange>
      <min>-42</min>
      <max>42</max>
    </allowedArrivalTemperatureRange>

    <factionIconPath>Things/World/SRY_IIcon</factionIconPath>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    
    <colorSpectrum>
	      <li>(132,211,105)</li>
    </colorSpectrum>
    <apparelStuffFilter>
      <thingDefs>
        <li>Synthread</li>
        <li>Hyperweave</li>
        <li>Plasteel</li>
      </thingDefs>
	  </apparelStuffFilter>

    <baseTraderKinds>
		    <li>Orbital_BulkGoods</li>
        <li>Orbital_CombatSupplier</li>
        <li>Orbital_Exotic</li>
	  </baseTraderKinds>
    <xenotypeSet>
      <xenotypeChances>
          <BTSX_Starborn>0.21</BTSX_Starborn>
          <Baseliner MayRequire="Ludeon.Rimworld.Biotech">0.28</Baseliner>
          <Hussar MayRequire="Ludeon.RimWorld.Biotech">0.2</Hussar>
          <Genie MayRequire="Ludeon.RimWorld.Biotech">0.05</Genie>
          <Starjack MayRequire="Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Odyssey">0.26</Starjack>
      </xenotypeChances>
    </xenotypeSet>

    <backstoryFilters>
      <li>
        <categories>
          <li>Offworld</li>
        </categories>
      </li>
    </backstoryFilters>
    <colorSpectrum>
	      <li>(132,211,105)</li>
    </colorSpectrum>
  <classicIdeo>false</classicIdeo>
  <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
  <settlementGenerationWeight>1</settlementGenerationWeight>
  <requiredCountAtGameStart>1</requiredCountAtGameStart>
  <canMakeRandomly>true</canMakeRandomly>
  <allowedCultures>
    <li>BTS_Starfinders</li>
  </allowedCultures>
  <modExtensions>
		<li Class="BetweenTheStars.FactionGenOptions">
			<preceptsToAdd>
				<li MayRequire="Ludeon.RimWorld.Ideology">Slavery_Acceptable</li>
				<li MayRequire="Ludeon.RimWorld.Ideology">IdeoDiversity_Disapproved</li>
				<li MayRequire="Ludeon.RimWorld.Ideology">MarriageName_Random</li>
				<li MayRequire="Ludeon.RimWorld.Ideology">SpouseCount_Male_Unlimited</li>
				<li MayRequire="Ludeon.RimWorld.Ideology">SpouseCount_Female_Unlimited</li>
				<li MayRequire="Ludeon.RimWorld.Ideology">OrganUse_Acceptable</li>
				<li MayRequire="Ludeon.RimWorld.Ideology">Lovin_SpouseOnly_Mild</li>
				<li MayRequire="Ludeon.RimWorld.Ideology">Apostasy_Abhorrent</li>
        <li MayRequire="Ludeon.Rimworld.Ideology,Ludeon.Rimworld.Anomaly">VoidStudy_VeryEfficient</li>
        <li MayRequire="Ludeon.Rimworld.Ideology,Ludeon.Rimworld.Biotech">ChildLabor_Encouraged</li>
        <li MayRequire="Ludeon.Rimworld.Ideology">NutrientPasteEating_DontMind</li>
        <li MayRequire="Ludeon.Rimworld.Ideology">Blinding_Horrible</li>
        <li MayRequire="Ludeon.Rimworld.Ideology">BodyMod_Approved</li>
        <li MayRequire="Ludeon.Rimworld.Ideology">Execution_DontCare</li>
        <li MayRequire="Ludeon.Rimworld.Ideology,Ludeon.Rimworld.Odyssey">Indoors_Acceptable</li>
        <li MayRequire="Ludeon.Rimworld.Ideology,Ludeon.Rimworld.Odyssey">Temperature_Tough</li>
        <li MayRequire="Ludeon.Rimworld.Ideology">SleepAccelerator_Preferred</li>
        <li MayRequire="Ludeon.Rimworld.Ideology">NeuralSupercharge_Preferred</li>
        <li MayRequire="Ludeon.Rimworld.Ideology">Biosculpting_Accelerated</li>
        <li MayRequire="Ludeon.Rimworld.Ideology,Ludeon.Rimworld.Odyssey">SpaceHabitat_Preferred</li>
			</preceptsToAdd>
			<hasUniqueIdeo MayRequire="Ludeon.RimWorld.Ideology">true</hasUniqueIdeo>
			<customIdeoIcon MayRequire="Ludeon.RimWorld.Ideology">BTS_IdeoIcon</customIdeoIcon>
			<customIdeoDescription>Reality is right in front of us. For centuries our ancestors explored the worlds given to them. Finding. Learning. Now, we continue their journey to the ultimate goal of understanding truly what we live in. Once we spread across the stars, we began to understand the forces beyond what we could observe. It is imperative, then, that we elevate ourselves to that position. Move beyond the frail bodies we were given and create a greater form with them. We must reach out into the dark night and wrap our hands around those silent arbiters that idle between the stars. This is our purpose, and we must not stray.</customIdeoDescription>
		</li>
	</modExtensions>

  <disallowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
	  <li MayRequire="Ludeon.RimWorld.Ideology">PainIsVirtue</li>
	  <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Animist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_OriginChristian</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_OriginHindu</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_OriginIslamic</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_OriginBuddhist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">MaleSupremacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">FemaleSupremacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">NaturePrimacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">FleshPurity</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Cannibal</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">HighLife</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Rancher</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Darkness</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Tunneler</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">TreeConnection</li>
    </disallowedMemes>
    <disallowedPrecepts>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudity_Male_CoveringAnythingButGroinDisapproved</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudity_Female_CoveringAnythingButGroinDisapproved</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">IdeoDiversity_Standard</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">IdeoDiversity_Approved</li>
    </disallowedPrecepts>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Loyalist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Transhumanist</li>
      <li MayRequire="Ludeon.Rimworld.Ideology,Ludeon.RimWorld.Odyssey">Shipborn</li>
    </requiredMemes>

    <structureMemeWeights>
      <Structure_TheistEmbodied MayRequire="Ludeon.RimWorld.Ideology">0</Structure_TheistEmbodied>
      <Structure_TheistAbstract MayRequire="Ludeon.RimWorld.Ideology">0</Structure_TheistAbstract>
      <Structure_Ideological MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Ideological>
      <Structure_Archist MayRequire="Ludeon.RimWorld.Ideology">0</Structure_Archist>
      <Structure_OriginChristian MayRequire="Ludeon.RimWorld.Ideology">0</Structure_OriginChristian>
      <Structure_OriginIslamic MayRequire="Ludeon.RimWorld.Ideology">0</Structure_OriginIslamic>
      <Structure_OriginHindu MayRequire="Ludeon.RimWorld.Ideology">0</Structure_OriginHindu>
      <Structure_OriginBuddhist MayRequire="Ludeon.RimWorld.Ideology">0</Structure_OriginBuddhist>
    </structureMemeWeights>
	
    <pawnGroupMakers>
	
	      <li>
            <!-- Frontiermen fights -->
            <kindDef>Combat</kindDef>
            <commonality>60</commonality>
            <options>
                <BTS_Frontierman>100</BTS_Frontierman>
            </options>
        </li>
        <li>
            <!-- Frontiermen and Marksmen -->
            <kindDef>Combat</kindDef>
            <commonality>80</commonality>
            <options>
                <BTS_Frontierman>50</BTS_Frontierman>
                <BTS_Marksman>51</BTS_Marksman>
            </options>
        </li>
        <li>
            <!-- In come the power troops -->
            <kindDef>Combat</kindDef>
            <commonality>90</commonality>
            <disallowedStrategies>
              <li>Siege</li>
            </disallowedStrategies>
            <options>
                <BTS_Marksman>20</BTS_Marksman>
                <BTS_POWER_Frontierman>60</BTS_POWER_Frontierman>
                <BTS_POWER_Marksman>50</BTS_POWER_Marksman>
            </options>
        </li>
        <!-- With mod integrations chances for warcaskets to appear when Vanilla Factions Expanded - Pirates is installed. You can undo this by deleting the MI_Patches_VPE.xml in the mod folder-->
        <li>
            <!-- This is bad -->
            <kindDef>Combat</kindDef>
            <commonality>28</commonality>
            <disallowedStrategies>
              <li>Siege</li>
              <li>StageThenAttack</li>
            </disallowedStrategies>
            <options>
                <BTS_POWER_Marksman>100</BTS_POWER_Marksman>
                <BTS_POWER_Heavy>90</BTS_POWER_Heavy>
                <BTS_POWER_Technical>20</BTS_POWER_Technical>
                <BTS_GAUSS_Light>10</BTS_GAUSS_Light>
                <BTS_GAUSS_Heavy>10</BTS_GAUSS_Heavy>
            </options>
        </li>
        <li>
            <!-- time to add a vanilla expanded mod or two... (no real shade its a good joke, even if some of them are unbalanced :P) -->
            <kindDef>Combat</kindDef>
            <commonality>25</commonality>
            <disallowedStrategies>
              <li>Siege</li>
              <li>StageThenAttack</li>
            </disallowedStrategies>
            <options>
                <BTS_POWER_Heavy>40</BTS_POWER_Heavy>
                <BTS_GAUSS_Light>88</BTS_GAUSS_Light>
                <BTS_GAUSS_Heavy>76</BTS_GAUSS_Heavy>
                <BTS_Chairman>1</BTS_Chairman>
            </options>
        </li>
        <!-- ============================================================================ -->
        <li>
            <kindDef>Settlement</kindDef>
            <options>
                <BTS_POWER_Heavy>60</BTS_POWER_Heavy>
                <BTS_POWER_Technical>50</BTS_POWER_Technical>
                <BTS_GAUSS_Light>90</BTS_GAUSS_Light>
                <BTS_GAUSS_Heavy>90</BTS_GAUSS_Heavy>
                <BTS_Chairman>1</BTS_Chairman>
            </options>
        </li>

	  </pawnGroupMakers>

  </FactionDef>
 <!-- =============================================================================================================-->
   <IdeoIconDef>
    <defName>BTS_IdeoIcon</defName>
    <iconPath>Things/World/SRY_IIcon</iconPath>
    <cultures>
      <li MayRequire="Ludeon.RimWorld.Ideology">BTS_Starfinders</li>
    </cultures>
    <memes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Transhumanist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Loyalist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology,Ludeon.RimWorld.Odyssey">Shipborn</li>
    </memes>
  </IdeoIconDef>


</Defs>