    <RecipeDef ParentName="ArchoTechMakeableBase">
        <defName>Make_ArchoComponent</defName>
        <label>make archotech component</label>
        <description>Allows you to directly decrypt lost or stolen Starway data into archotech components.</description>
        <jobString>Decrypting into archotech component.</jobString>
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <effectWorking>Cook</effectWorking>
        <soundWorking>Recipe_Machining</soundWorking>
        <workAmount>8000</workAmount>
        <ingredients>
            <li>
                <filter>
                <thingDefs>
                    <li>AncientResearchCore</li>
                </thingDefs>
                </filter>
                <count>1</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
        <thingDefs>
            <li>AncientResearchCore</li>
        </thingDefs>
        </fixedIngredientFilter>
        <products>
            <ArchoComponent>1</ArchoComponent>
        </products>
        <skillRequirements Inherit="False">
            <Crafting>5</Crafting>
        </skillRequirements>
    </RecipeDef>

