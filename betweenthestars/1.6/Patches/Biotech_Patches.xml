<?xml version="1.0" encoding="utf-8"?>
<Patch>
        <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Biotech</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="Gun_BeamGraser"]</xpath>
                    <value>
                        <comps Inherit="True">
                            <li Class="CompProperties_Biocodable"/>
                        </comps>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/FactionDef[defName="BTS_Starway"]</xpath>
                    <value>
                        <xenotypeSet>
                            <xenotypeChances>
                                <Starborn>0.3</Starborn>
                                <Baseliner>0.3</Baseliner>
                                <Hussar>0.35</Hussar>
                                <Genie>0.05</Genie>
                                <Starjack MayRequire="Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Odyssey">0.26</Starjack>
                            </xenotypeChances>
                        </xenotypeSet>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/PawnKindDef[defName="BTS_Chariman"]</xpath>
                    <value>
                        <xenotypeSet Inherit="False">
                            <xenotypeChances>
                                <BTSX_Starborn>900</BTSX_Starborn>
                                <Genie>99</Genie>
                            </xenotypeChances>
                        </xenotypeSet>
                    </value>
                </li>
                <li Class="PatchOperationReplace">
                    <xpath>Defs/PawnKindDef[defName="AncientResearchCore"]/comps/li[@Class="CompProperties_UseEffectPlaySound"]/soundOnUsed</xpath>
                    <value>
                        <soundOnUsed>DatacoreRead</soundOnUsed>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Biotech</li>
            <li>Jaguar and Snow Leopard Xenotypes</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs/FactionDef[defName="BTS_Starway"]/xenotypeSet/xenotypeChances</xpath>
                        <value>
                            <CYB_Uncia>0.12</CYB_Uncia>
                        </value>
                </li>
            </operations>
        </match>
    </Operation>

</Patch>