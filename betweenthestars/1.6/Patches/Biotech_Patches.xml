<?xml version="1.0" encoding="utf-8"?>
<Patch>
        <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Biotech</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationReplace">
                    <xpath>Defs/RecipeDef[defName="Make_MechResurrect"]/researchPrerequisites</xpath>
                    <value>
                        <researchPrerequisites>
                            <li>ShipCryptosleep</li>
                            <li>Bioregeneration</li>
                            <li>QuantUnderstand</li>
                        </researchPrerequisites>
                    </value>
                </li>
                <li Class="PatchOperationReplace">
                    <xpath>Defs/RecipeDef[defName="Make_MechHeal"]/researchPrerequisites</xpath>
                    <value>
                        <researchPrerequisites>
                            <li>ShipCryptosleep</li>
                            <li>Bioregeneration</li>
                            <li>QuantUnderstand</li>
                        </researchPrerequisites>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/RecipeDef[defName="Make_AnimalPulser"]/researchPrerequisites</xpath>
                    <value>
                        <li>Archogenetics</li>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="Gun_BeamGraser"]</xpath>
                    <value>
                        <comps Inherit="True">
                            <li Class="CompProperties_Biocodable"/>
                        </comps>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/FactionDef[defName="BTS_Starway"]</xpath>
                    <value>
                        <xenotypeSet>
                            <xenotypeChances>
                                <BTSX_Starborn>0.3</BTSX_Starborn>
                                <Baseliner>0.3</Baseliner>
                                <Hussar>0.35</Hussar>
                                <Genie>0.05</Genie>
                                <Starjack>0.26</Starjack>
                            </xenotypeChances>
                        </xenotypeSet>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/PawnKindDef[defName="BTS_Chairman"]</xpath>
                    <value>
                        <xenotypeSet>
                            <xenotypeChances>
                                <BTSX_Starborn>900</BTSX_Starborn>
                                <Genie>99</Genie>
                            </xenotypeChances>
                        </xenotypeSet>
                    </value>
                </li>
                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="AncientResearchCore"]/comps/li[@Class="CompProperties_UseEffectPlaySound"]/soundOnUsed</xpath>
                    <value>
                        <soundOnUsed>DatacoreRead</soundOnUsed>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs/RecipeDef[defName="Make_PersonaCore"]/ingredients</xpath>
                        <value>
                            <li>
                                <filter>
                                <thingDefs>
                                    <li>SubcoreHigh</li>
                                </thingDefs>
                                </filter>
                                <count>1</count>
                            </li>
                        </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs/RecipeDef[defName="Make_SC"]/ingredients</xpath>
                        <value>
                            <li>
                                <filter>
                                <thingDefs>
                                    <li>SubcoreRegular</li>
                                </thingDefs>
                                </filter>
                                <count>1</count>
                            </li>
                        </value>
                </li>
            </operations>
        </match>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Jaguar and Snow Leopard Xenotypes</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs/FactionDef[defName="BTS_Starway"]/xenotypeSet/xenotypeChances</xpath>
                        <value>
                            <CYB_Uncia>0.12</CYB_Uncia>
                        </value>
                </li>
            </operations>
        </match>
    </Operation>

</Patch>