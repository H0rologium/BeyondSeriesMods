<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Save Our Ship 2</li>
        </mods>
        <nomatch Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="Ship_SensorCluster"]/comps</xpath>
                    <value>
                        <li Class="CompProperties_Facility">
                                <statOffsets><ResearchSpeedFactor>0.3</ResearchSpeedFactor>
                                </statOffsets>
                            <maxSimultaneous>1</maxSimultaneous>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="Ship_SensorCluster"]/placeWorkers</xpath>
                    <value>
                        <li>PlaceWorker_ShowFacilitiesConnections</li>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="Ship_SensorCluster"]</xpath>
                    <value>
                        <minifiedDef>MinifiedThing</minifiedDef>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="Ship_SensorCluster"]</xpath>
                    <value>
                        <thingCategories>
                            <li>BuildingsMisc</li>
                        </thingCategories>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="Ship_SensorCluster"]/statBases</xpath>
                    <value>
                        <Mass>80</Mass>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="HiTechResearchBench"]/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities</xpath>
                    <value>
                        <li>Ship_SensorCluster</li>
                    </value>
                </li>
            </operations>
        </nomatch>
    </Operation>
</Patch>