<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Anomaly</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationReplace">
                    <xpath>/Defs/PawnKindDef[defName="BTS_Chairman"]/startingHediffs</xpath>
                        <value>
                            <li>
                                <def MayRequire="Ludeon.Rimworld.Anomaly">Metalblood</def>
                                <severity>1.0</severity>
                                <chance>1.0</chance>
                            </li>
                        </value>
                </li>
            </operations>
        </match>
    </Operation>

</Patch>